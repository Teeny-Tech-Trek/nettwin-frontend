# Frontend configuration for Digital Twin (Vite)
# Copy to .env and fill in actual values.

# Base URL of the backend API (must include /api).
# In production set this to your deployed backend.
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: base URL used for image/static asset paths.
# If omitted, derived from VITE_API_BASE_URL by stripping the trailing /api.
# VITE_IMAGE_BASE_URL=http://localhost:5000

# Google OAuth Client ID (Web application).
# MUST match GOOGLE_CLIENT_ID configured on the backend so server-side
# token verification (audience check) succeeds.
# Get from: https://console.cloud.google.com/apis/credentials
#
# In the same Google Cloud Console OAuth Client config, add these URIs:
#   Authorized JavaScript origins:
#     http://localhost:8080        <- Vite dev (see vite.config.ts → server.port)
#     https://your-production-domain.example.com
#   Authorized redirect URIs:
#     (none required — we use the popup ID-token flow, not the redirect flow)
#
# If "localhost:8080" is missing from Authorized JavaScript origins, the
# Google button will fail to load and you'll see "status?client_id=…" and
# "clientmetadata?client_id=…" requests fail in DevTools → Network.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Razorpay public key (rzp_test_... or rzp_live_...).
# The frontend uses this to open the checkout popup. It must match the
# Razorpay key the TTT Payment Service was configured with on the backend
# side — otherwise Razorpay rejects the order with a key mismatch.
# Get from: https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY=rzp_test_replace_with_your_key
